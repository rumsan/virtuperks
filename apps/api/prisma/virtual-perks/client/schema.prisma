generator client {
  provider = "prisma-client-js"
  output   = "../virtual-perks/client"
}

datasource db {
  provider = "postgresql"
  url      = env("VIRTUAL_PERKS_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  cuid         String        @unique @default(cuid())
  gender       Gender        @default(UNKNOWN)
  email        String?
  phone        String?
  wallet       String?       @unique
  notes        String?
  sessionId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  ManagedUsers UserDetails[] @relation("Manager")
  details      UserDetails?  @relation("UserDetails")

  @@index([wallet])
  @@map("tbl_users")
}

model UserDetails {
  cuid             String    @unique
  name             String?
  departmentId     String?
  salary           Float     @default(0)
  userType         UserType?
  managerId        String?
  isApproved       Boolean   @default(false)
  extras           Json?
  timeoffAllowance Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  Manager          User?     @relation("Manager", fields: [managerId], references: [cuid], map: "UserDetails_Manager_fkey")
  User             User      @relation("UserDetails", fields: [cuid], references: [cuid], map: "UserDetails_User_fkey")

  @@map("tbl_users_details")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum UserType {
  EMPLOYEE
  VOLUNTEER
  CONTRACTOR
  INTERN
}
