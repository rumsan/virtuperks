// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reward {
  cuid        String       @id @unique @default(cuid())
  title       String       @db.VarChar(255)
  description String?
  category    String?
  tokens      Int
  wallet      String
  isActive    Boolean      @default(true)
  imageUrl    String?      @db.VarChar(255)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  redemptions Redemption[]
}

model Phone {
  cuid              String       @id @unique @default(cuid())
  phoneNumber       String       @unique @db.VarChar(20)
  userWalletAddress String       @unique @db.VarChar(42)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  redemptions       Redemption[]

  @@index([phoneNumber])
  @@index([userWalletAddress])
}

model Redemption {
  cuid            String           @id @unique @default(cuid())
  rewardId        String
  phoneId         String
  reward          Reward           @relation(fields: [rewardId], references: [cuid])
  phone           Phone            @relation(fields: [phoneId], references: [cuid])
  transactionHash String           @db.VarChar(66)
  status          RedemptionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([rewardId])
  @@index([phoneId])
  @@index([status])
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  FAILED
  CANCELLED
  REJECTED
  SUCCESS
}
