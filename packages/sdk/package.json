{
  "name": "@workspace/sdk",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "latest"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
     "./clients": {
      "import": "./dist/clients/index.js",
      "require": "./dist/clients/index.js",
      "types": "./dist/clients/index.d.ts"
    },
    "./clients/*": {
      "import": "./dist/clients/*.js",
      "require": "./dist/clients/*.js",
      "types": "./dist/clients/*.d.ts"
    },
    "./type": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.js",
      "require": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/events.js",
      "require": "./dist/constants/events.js",
      "types": "./dist/constants/events.d.ts"
    }
  },
  "dependencies": {
    "axios": "^1.12.2",
   "@rumsan/sdk": "^0.2.10"
  }
}