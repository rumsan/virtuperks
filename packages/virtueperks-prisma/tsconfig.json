{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext", // Changed from NodeNext to ESNext
    "moduleResolution": "node", // Changed from nodenext to node
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@client/*": ["./client/*"] // Added alias for client directory
    }
  },
  "include": ["./src", "./prisma", "./client"], // Added client directory
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}